<?xml version="1.0" encoding="utf-8"?>
<!--
  Next Prayer Widget (4×2) — 100% RemoteViews-Safe Architecture
  ─────────────────────────────────────────────────────────────
  TOP    : Left "نور • NEXT PRAYER" · Right Hijri Date + Clock + Countdown Pill
  MIDDLE : Left Prayer Name + City Pill · Right Large Prayer Time + Safe ProgressBar
  BOTTOM : Full 5-Prayer Strip (FAJR, DHUHR, ASR, MAGHRIB, ISHA) with Active Highlight
  ─────────────────────────────────────────────────────────────
  ZERO <View> tags allowed (avoids InflateException in RemoteViews)
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <!-- Dynamically rendered offscreen rounded background & opacity bitmap -->
    <ImageView
        android:id="@+id/widget_bg_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="@null" />

    <LinearLayout
        android:id="@+id/widget_content_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="8dp"
        android:layoutDirection="locale"
        android:textDirection="locale">

        <!-- ══════ TOP BAR ══════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Title: "نور • NEXT PRAYER" -->
            <TextView
                android:id="@+id/widget_header_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="0"
                android:text="نور • NEXT PRAYER"
                android:textColor="@color/widget_accent_gold"
                android:textSize="10sp"
                android:textStyle="bold"
                android:singleLine="true" />

            <!-- RemoteViews-Safe Spacer (FrameLayout, NEVER <View>) -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Hijri Date pill (Concise, single-line, ellipsized so it never encroaches countdown) -->
            <TextView
                android:id="@+id/widget_hijri_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_chip_shape"
                android:paddingStart="7dp"
                android:paddingEnd="7dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:singleLine="true"
                android:ellipsize="end"
                android:maxWidth="130dp"
                android:text="18 Jumādā I 1448"
                android:textColor="@color/widget_accent_gold"
                android:textSize="10sp"
                android:textStyle="bold"
                android:layout_marginEnd="6dp" />

            <!-- Countdown pill (Unclipped, wrap_content, weight=0, ellipsize=none) -->
            <TextView
                android:id="@+id/widget_countdown_pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="0"
                android:background="@drawable/widget_chip_emerald"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:singleLine="true"
                android:ellipsize="none"
                android:text="In 46m"
                android:textColor="@color/widget_accent_emerald"
                android:textSize="10.5sp"
                android:textStyle="bold" />

            <!-- Legacy Clock stub (kept hidden to free top bar room and avoid clipping) -->
            <TextClock
                android:id="@+id/widget_clock"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- ══════ MIDDLE MAIN ROW ══════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="2dp">

            <!-- Left: NEXT PRAYER + Hero Prayer Name + City Pill -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="start|center_vertical">

                <TextView
                    android:id="@+id/widget_section_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.10"
                    android:text="@string/widget_next_prayer_section"
                    android:textAllCaps="true"
                    android:textColor="@color/widget_accent_gold"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:alpha="0.75" />

                <TextView
                    android:id="@+id/widget_prayer_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/prayer_maghrib"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <!-- City pill -->
                <LinearLayout
                    android:id="@+id/widget_city_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:background="@drawable/widget_chip_shape"
                    android:paddingStart="6dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="1.5dp"
                    android:paddingBottom="1.5dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="3dp"
                        android:text="📍"
                        android:textSize="8.5sp" />

                    <TextView
                        android:id="@+id/widget_location"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:maxWidth="130dp"
                        android:text="@string/widget_location_default"
                        android:textColor="@color/widget_text_secondary"
                        android:textSize="9sp" />
                </LinearLayout>

                <!-- Stale badge (permanently gone) -->
                <TextView
                    android:id="@+id/widget_stale_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Right: Prayer Time + Safe Horizontal ProgressBar -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="end|center_vertical">

                <TextView
                    android:id="@+id/widget_prayer_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_time_default"
                    android:textColor="@color/widget_text_primary"
                    android:fontFamily="sans-serif-condensed"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:letterSpacing="-0.02"
                    android:includeFontPadding="false" />

                <ProgressBar
                    android:id="@+id/widget_progress_bar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="85dp"
                    android:layout_height="5dp"
                    android:layout_marginTop="3dp"
                    android:max="100"
                    android:progress="0" />
            </LinearLayout>
        </LinearLayout>

        <!-- ══════ BOTTOM 5-PRAYER STRIP ══════ -->
        <LinearLayout
            android:id="@+id/widget_five_prayer_strip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="5"
            android:paddingTop="3dp"
            android:paddingBottom="1dp">

            <!-- Fajr -->
            <LinearLayout
                android:id="@+id/widget_col_fajr"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:paddingStart="1dp"
                android:paddingEnd="1dp">
                <TextView
                    android:id="@+id/widget_name_fajr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FAJR"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:textColor="@color/widget_accent_gold" />
                <TextView
                    android:id="@+id/widget_time_fajr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="05:28"
                    android:textSize="9sp"
                    android:textColor="@color/widget_text_secondary"
                    android:fontFamily="sans-serif-condensed" />
            </LinearLayout>

            <!-- Dhuhr -->
            <LinearLayout
                android:id="@+id/widget_col_dhuhr"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:paddingStart="1dp"
                android:paddingEnd="1dp">
                <TextView
                    android:id="@+id/widget_name_dhuhr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DHUHR"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:textColor="@color/widget_accent_gold" />
                <TextView
                    android:id="@+id/widget_time_dhuhr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="12:24"
                    android:textSize="9sp"
                    android:textColor="@color/widget_text_secondary"
                    android:fontFamily="sans-serif-condensed" />
            </LinearLayout>

            <!-- Asr -->
            <LinearLayout
                android:id="@+id/widget_col_asr"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:paddingStart="1dp"
                android:paddingEnd="1dp">
                <TextView
                    android:id="@+id/widget_name_asr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ASR"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:textColor="@color/widget_accent_gold" />
                <TextView
                    android:id="@+id/widget_time_asr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="04:28"
                    android:textSize="9sp"
                    android:textColor="@color/widget_text_secondary"
                    android:fontFamily="sans-serif-condensed" />
            </LinearLayout>

            <!-- Maghrib -->
            <LinearLayout
                android:id="@+id/widget_col_maghrib"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:paddingStart="1dp"
                android:paddingEnd="1dp">
                <TextView
                    android:id="@+id/widget_name_maghrib"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MAGHRIB"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:textColor="@color/widget_accent_gold" />
                <TextView
                    android:id="@+id/widget_time_maghrib"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="06:04"
                    android:textSize="9sp"
                    android:textColor="@color/widget_text_secondary"
                    android:fontFamily="sans-serif-condensed" />
            </LinearLayout>

            <!-- Isha -->
            <LinearLayout
                android:id="@+id/widget_col_isha"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:paddingStart="1dp"
                android:paddingEnd="1dp">
                <TextView
                    android:id="@+id/widget_name_isha"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ISHA"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:textColor="@color/widget_accent_gold" />
                <TextView
                    android:id="@+id/widget_time_isha"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="07:16"
                    android:textSize="9sp"
                    android:textColor="@color/widget_text_secondary"
                    android:fontFamily="sans-serif-condensed" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Empty state (hidden by default) -->
    <LinearLayout
        android:id="@+id/layout_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_empty_title"
            android:textColor="@color/widget_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
