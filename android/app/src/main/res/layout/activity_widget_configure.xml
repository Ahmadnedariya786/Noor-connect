<?xml version="1.0" encoding="utf-8"?>
<!-- Widget Configuration Activity Layout -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="@string/widget_configure_title"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/widget_text_primary" />

        <!-- Widget Size -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="@string/widget_configure_size_label">

            <Spinner
                android:id="@+id/spinner_widget_size"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Theme Selection -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/widget_configure_theme_label"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/widget_text_primary" />

        <RadioGroup
            android:id="@+id/radiogroup_theme"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:orientation="horizontal"
            android:gravity="center">

            <RadioButton
                android:id="@+id/radio_system"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/widget_theme_system"
                android:buttonTint="@color/widget_accent_emerald" />

            <RadioButton
                android:id="@+id/radio_light"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/widget_theme_light"
                android:buttonTint="@color/widget_accent_emerald" />

            <RadioButton
                android:id="@+id/radio_dark"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/widget_theme_dark"
                android:buttonTint="@color/widget_accent_emerald" />
        </RadioGroup>

        <!-- Data Density -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/widget_configure_density_label"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/widget_text_primary" />

        <SeekBar
            android:id="@+id/seekbar_data_density"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:max="100"
            android:progress="50"
            android:progressTint="@color/widget_accent_emerald"
            android:thumbTint="@color/widget_accent_emerald" />

        <!-- Accent Color -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:hint="@string/widget_configure_accent_label">

            <Spinner
                android:id="@+id/spinner_accent_color"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/btn_cancel"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:text="@string/widget_configure_cancel" />

            <Button
                android:id="@+id/btn_save"
                style="@style/Widget.Material3.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_configure_save" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>