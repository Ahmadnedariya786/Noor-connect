<?xml version="1.0" encoding="utf-8"?>
<!--
  Arabesque horizontal divider — uses a gradient fade from transparent to
  gold and back, giving a premium "ruled line" look.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Gradient fade line -->
    <item
        android:top="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:startColor="#00F59E0B"
                android:centerColor="#80F59E0B"
                android:endColor="#00F59E0B"
                android:angle="0" />
        </shape>
    </item>

    <!-- Tiny central diamond ornament -->
    <item
        android:gravity="center"
        android:width="6dp"
        android:height="6dp">
        <rotate
            android:fromDegrees="45"
            android:toDegrees="45"
            android:pivotX="50%"
            android:pivotY="50%">
            <shape android:shape="rectangle">
                <solid android:color="@color/widget_accent_gold" />
            </shape>
        </rotate>
    </item>

</layer-list>
