<?xml version="1.0" encoding="utf-8"?>
<!-- Widget card background: deep dark surface with emerald-tinted border -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Outer glow/shadow layer -->
    <item
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_glow_layer" />
            <corners android:radius="26dp" />
        </shape>
    </item>

    <!-- Main surface card -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_bg_surface" />
            <stroke android:width="1dp" android:color="@color/widget_border" />
            <corners android:radius="24dp" />
        </shape>
    </item>

</layer-list>
