<?xml version="1.0" encoding="utf-8"?>
<!--
  8-point Islamic star ornament (Rub el Hizb style).
  Used as faint corner accent on widgets.
  24dp vector drawable, color via tint.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="@color/widget_accent_emerald">

    <!-- Star formed by two overlapping squares rotated 45° -->
    <path
        android:fillAlpha="0.15"
        android:strokeAlpha="0.4"
        android:fillColor="#FFFFFF"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="0.5"
        android:pathData="M12,2 L14.5,9.5 L22,12 L14.5,14.5 L12,22 L9.5,14.5 L2,12 L9.5,9.5 Z" />

    <!-- Inner star -->
    <path
        android:fillAlpha="0.1"
        android:fillColor="#FFFFFF"
        android:pathData="M12,7 L13.5,10.5 L17,12 L13.5,13.5 L12,17 L10.5,13.5 L7,12 L10.5,10.5 Z" />
</vector>
