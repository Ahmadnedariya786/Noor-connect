# Auto-detect text files and normalize to LF
* text=auto eol=lf

# Binary files — never touch line endings
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.mp3 binary
*.mp4 binary
*.wav binary
*.ogg binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.zip binary
*.tar binary
*.gz binary
*.apk binary
*.keystore binary
*.jks binary

# Windows batch files need CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
